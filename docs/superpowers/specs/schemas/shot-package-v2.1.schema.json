{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localminidrama.local/schemas/shot-package-v2.1.schema.json",
  "title": "LocalMiniDrama V2.1 Internal Shot Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "shot_id",
    "revision",
    "story_scene_ids",
    "planned_duration_seconds",
    "story_intent",
    "visual",
    "timed_segments",
    "continuity",
    "look_ref",
    "references",
    "audio"
  ],
  "properties": {
    "schema": { "const": "local-mini-drama.shot-package" },
    "version": { "type": "string", "const": "2.1" },
    "shot_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "story_scene_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "planned_duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "request_duration_seconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "story_intent": { "type": "string", "minLength": 1 },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_size", "camera_angle", "camera_movement", "composition", "lighting"],
      "properties": {
        "shot_size": { "type": "string", "minLength": 1 },
        "camera_angle": { "type": "string", "minLength": 1 },
        "camera_movement": { "type": "string", "minLength": 1 },
        "composition": { "type": "string", "minLength": 1 },
        "lighting": { "type": "string", "minLength": 1 }
      }
    },
    "timed_segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/timedSegment" }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "exit", "axis"],
      "properties": {
        "entry": { "$ref": "#/$defs/stringMap" },
        "exit": { "$ref": "#/$defs/stringMap" },
        "axis": { "type": ["string", "null"] }
      }
    },
    "look_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_id", "fingerprint"],
      "properties": {
        "version_id": { "$ref": "#/$defs/id" },
        "fingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialogue", "narration", "ambience", "sound_effects", "music_intent"],
      "properties": {
        "dialogue": { "type": "array", "items": { "$ref": "#/$defs/speechEvent" } },
        "narration": { "type": "array", "items": { "$ref": "#/$defs/speechEvent" } },
        "ambience": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sound_effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "music_intent": { "type": ["string", "null"] }
      }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "id": { "type": ["string", "integer"], "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" } },
    "stringMap": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
    "speechEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "end_seconds", "text"],
      "properties": {
        "speaker_asset_version_id": { "$ref": "#/$defs/id" },
        "start_seconds": { "type": "number", "minimum": 0 },
        "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "text": { "type": "string", "minLength": 1 },
        "performance": { "type": "string" }
      }
    },
    "timedSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_seconds",
        "end_seconds",
        "action",
        "scene_asset_version_ids",
        "character_state_version_ids",
        "prop_version_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "start_seconds": { "type": "number", "minimum": 0 },
        "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "action": { "type": "string", "minLength": 1 },
        "camera": { "type": "string" },
        "dialogue": { "type": "array", "items": { "$ref": "#/$defs/speechEvent" } },
        "scene_asset_version_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "character_state_version_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "prop_version_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "required"],
      "properties": {
        "role": {
          "enum": [
            "scene_view",
            "character_identity",
            "character_state",
            "prop",
            "first_frame",
            "last_frame",
            "continuity_frame",
            "reference_audio",
            "mask",
            "source_video"
          ]
        },
        "asset_version_id": { "$ref": "#/$defs/id" },
        "artifact_id": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" },
        "note": { "type": "string" }
      },
      "oneOf": [
        { "required": ["asset_version_id"] },
        { "required": ["artifact_id"] }
      ]
    }
  }
}
