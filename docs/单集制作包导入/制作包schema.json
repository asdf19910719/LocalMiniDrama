{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "local-mini-drama.external-ai-result",
  "title": "LocalMiniDrama 外部 AI 单集增量结果",
  "description": "由项目任务包约束的严格增量结果。已有资产只引用，新资产只在 new_assets 中声明。",
  "type": "object",
  "required": [
    "schema",
    "version",
    "prompt_contract",
    "package_id",
    "episode",
    "new_assets",
    "storyboards"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "local-mini-drama.external-ai-result"
    },
    "version": {
      "const": "2"
    },
    "prompt_contract": {
      "const": "base_prompt"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "audio_plan": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "bgm": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "episode_track",
                "per_segment"
              ]
            },
            "prompt": {
              "type": [
                "string",
                "null"
              ]
            },
            "planning": {
              "enum": [
                "manual",
                "ai",
                "external"
              ]
            },
            "continuity_key": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_type": {
              "enum": [
                "none",
                "local_file",
                "media_library",
                "generated"
              ]
            },
            "local_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "volume_db": {
              "type": "number"
            },
            "ducking_db": {
              "type": "number"
            },
            "fade_in_ms": {
              "type": "number",
              "minimum": 0
            },
            "fade_out_ms": {
              "type": "number",
              "minimum": 0
            },
            "crossfade_ms": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "mode",
            "planning",
            "source_type"
          ],
          "additionalProperties": false
        },
        "mastering": {
          "type": "object",
          "properties": {
            "target_lufs": {
              "type": "number"
            },
            "true_peak_db": {
              "type": "number"
            }
          },
          "required": [
            "target_lufs",
            "true_peak_db"
          ],
          "additionalProperties": false
        },
        "speech": {
          "type": "object",
          "properties": {
            "dialogue_owner": {
              "enum": [
                "h3_native",
                "post_tts",
                "none"
              ]
            },
            "narration_owner": {
              "enum": [
                "h3_native",
                "post_tts",
                "none"
              ]
            }
          },
          "required": [
            "dialogue_owner",
            "narration_owner"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "bgm",
        "mastering",
        "speech"
      ],
      "additionalProperties": false
    },
    "episode": {
      "type": "object",
      "properties": {
        "episode_number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "duration_target_seconds": {
          "type": "number",
          "minimum": 0.01
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "episode_number",
        "title",
        "summary",
        "script",
        "duration_target_seconds"
      ],
      "additionalProperties": false
    },
    "new_assets": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "local_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "main",
                  "supporting",
                  "minor"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "personality": {
                "type": "string",
                "minLength": 1
              },
              "appearance": {
                "type": "string",
                "minLength": 1
              },
              "base_image_prompt": {
                "type": "string",
                "minLength": 1
              },
              "negative_prompt": {
                "type": "string",
                "minLength": 1
              },
              "voice_profile": {
                "type": "string",
                "minLength": 1
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "local_ref": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "appearance": {
                      "type": "string",
                      "minLength": 1
                    },
                    "base_image_prompt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "negative_prompt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "is_default": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "local_ref",
                    "name",
                    "description",
                    "appearance",
                    "base_image_prompt",
                    "negative_prompt",
                    "is_default"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "local_ref",
              "name",
              "role",
              "description",
              "personality",
              "appearance",
              "base_image_prompt",
              "negative_prompt",
              "voice_profile",
              "variants"
            ],
            "additionalProperties": false
          }
        },
        "character_variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "local_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "character_ref": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "appearance": {
                "type": "string",
                "minLength": 1
              },
              "base_image_prompt": {
                "type": "string",
                "minLength": 1
              },
              "negative_prompt": {
                "type": "string",
                "minLength": 1
              },
              "is_default": {
                "type": "boolean"
              }
            },
            "required": [
              "local_ref",
              "character_ref",
              "name",
              "description",
              "appearance",
              "base_image_prompt",
              "negative_prompt",
              "is_default"
            ],
            "additionalProperties": false
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "local_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "atmosphere": {
                "type": "string",
                "minLength": 1
              },
              "base_image_prompt": {
                "type": "string",
                "minLength": 1
              },
              "negative_prompt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "local_ref",
              "name",
              "state",
              "description",
              "atmosphere",
              "base_image_prompt",
              "negative_prompt"
            ],
            "additionalProperties": false
          }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "local_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "base_image_prompt": {
                "type": "string",
                "minLength": 1
              },
              "negative_prompt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "local_ref",
              "name",
              "type",
              "description",
              "base_image_prompt",
              "negative_prompt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "characters",
        "character_variants",
        "scenes",
        "props"
      ],
      "additionalProperties": false
    },
    "storyboards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "local_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "storyboard_number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0.01
          },
          "scene_ref": {
            "type": "string",
            "minLength": 1
          },
          "character_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "character_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "variant_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "reference_role": {
                  "enum": [
                    "primary",
                    "supporting",
                    "background"
                  ]
                },
                "sort_order": {
                  "type": "integer",
                  "minimum": 1
                },
                "framing_note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "character_ref",
                "variant_ref",
                "reference_role",
                "sort_order",
                "framing_note"
              ],
              "additionalProperties": false
            }
          },
          "prop_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "shot_type": {
            "type": "string",
            "minLength": 1
          },
          "camera_angle": {
            "type": "string",
            "minLength": 1
          },
          "camera_movement": {
            "type": "string",
            "minLength": 1
          },
          "composition": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "minLength": 1
              },
              "progression": {
                "type": "string",
                "minLength": 1
              },
              "end": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "start",
              "progression",
              "end"
            ],
            "additionalProperties": false
          },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "speaker": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "string",
                  "minLength": 1
                },
                "performance": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "speaker",
                "line",
                "performance"
              ],
              "additionalProperties": false
            }
          },
          "narration": {
            "type": "string"
          },
          "audio_description": {
            "type": "object",
            "properties": {
              "ambience": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sound_effects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dialogue_treatment": {
                "type": "string",
                "minLength": 1
              },
              "silence": {
                "type": "boolean"
              },
              "music_cue": {
                "type": "object",
                "properties": {
                  "mode": {
                    "enum": [
                      "inherit",
                      "override",
                      "mute",
                      "stinger"
                    ]
                  },
                  "prompt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "intensity": {
                    "type": "number",
                    "minimum": 0
                  },
                  "start": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "end": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "mode",
                  "intensity",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ambience",
              "sound_effects",
              "dialogue_treatment",
              "silence",
              "music_cue"
            ],
            "additionalProperties": false
          },
          "transition": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "duration": {
                "type": "number",
                "minimum": 0
              },
              "visual_description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "audio_bridge": {
                "type": "object",
                "properties": {
                  "mode": {
                    "enum": [
                      "none",
                      "carry",
                      "fade",
                      "crossfade"
                    ]
                  },
                  "duration_ms": {
                    "type": "number",
                    "minimum": 0
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "mode",
                  "duration_ms",
                  "description"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "duration",
              "visual_description",
              "audio_bridge"
            ],
            "additionalProperties": false
          },
          "base_image_prompt": {
            "type": "string",
            "minLength": 1
          },
          "base_video_prompt": {
            "type": "string",
            "minLength": 1
          },
          "universal_segment_text": {
            "type": "string",
            "minLength": 1,
            "description": "万能提示词草稿。参考图必须使用规范槽位 @图片1、@图片2……：@图片1 为场景，随后按 character_refs.sort_order 为人物状态，最后为 prop_refs；禁止用 @场景/@人物/@道具或资产名称代替槽位。"
          },
          "is_primary": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "local_ref",
          "storyboard_number",
          "title",
          "description",
          "duration_seconds",
          "scene_ref",
          "character_refs",
          "prop_refs",
          "shot_type",
          "camera_angle",
          "camera_movement",
          "composition",
          "action",
          "dialogue",
          "narration",
          "audio_description",
          "transition",
          "base_image_prompt",
          "base_video_prompt",
          "universal_segment_text",
          "is_primary"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  }
}
